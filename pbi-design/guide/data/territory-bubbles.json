{
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": "container",
  "padding": 12,
  "transform": [
    {
      "filter": "isValid(datum['Sales']) && datum['Sales'] > 0"
    },
    {
      "calculate": "indexof(['Southwest','Northwest','Canada'], datum['Territory']) >= 0",
      "as": "Core"
    },
    {
      "calculate": "format(datum['Sales'], '$,.3s')",
      "as": "SalesLabel"
    }
  ],
  "encoding": {
    "x": {
      "field": "Map X",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": null
    },
    "y": {
      "field": "Map Y",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": null
    },
    "opacity": {
      "condition": {
        "test": {
          "field": "__selected__",
          "equal": "off"
        },
        "value": 0.25
      },
      "value": 1
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "stroke": "#FFFFFF",
        "strokeWidth": 2,
        "cursor": "pointer"
      },
      "encoding": {
        "size": {
          "field": "Sales",
          "type": "quantitative",
          "scale": {
            "range": [
              1000,
              16000
            ]
          },
          "legend": null
        },
        "color": {
          "condition": {
            "test": "datum.Core",
            "value": "#00338D"
          },
          "value": "#DCE6F1"
        },
        "tooltip": [
          {
            "field": "Territory",
            "type": "nominal"
          },
          {
            "field": "Sales",
            "type": "quantitative",
            "format": ",.2f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -8,
        "fontSize": 12,
        "fontWeight": "bold",
        "cursor": "pointer"
      },
      "encoding": {
        "text": {
          "field": "Territory"
        },
        "color": {
          "condition": {
            "test": "datum.Core",
            "value": "#FFFFFF"
          },
          "value": "#0C233C"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": 10,
        "fontSize": 15,
        "fontWeight": "bold",
        "cursor": "pointer"
      },
      "encoding": {
        "text": {
          "field": "SalesLabel"
        },
        "color": {
          "condition": {
            "test": "datum.Core",
            "value": "#FFFFFF"
          },
          "value": "#0C233C"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "transparent"
  }
}
